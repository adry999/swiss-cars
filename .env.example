# Copy to .env.local and fill in. Never commit .env.local.

# --- Required: Supabase -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Lead notifications -----------------------------------------------------
# Server-side only: no NEXT_PUBLIC_ prefix, or they ship to the browser.
# These used to live in the site_settings table, which is readable by anyone
# holding the public anon key. Keep them here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL=

# Required for the email half of lead notifications (Resend).
# Without it, Telegram still works and email silently no-ops.
RESEND_API_KEY=

# --- Analytics (optional) ---------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
